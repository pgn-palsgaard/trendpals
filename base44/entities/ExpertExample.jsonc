{
  "name": "ExpertExample",
  "type": "object",
  "required": [
    "source_id",
    "product_name",
    "analyst_framing"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "description": "Source entity ID this example was extracted from"
    },
    "report_title": {
      "type": "string",
      "description": "Title of the Mintel report"
    },
    "product_name": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "region_code": {
      "type": "string",
      "enum": [
        "ASPAC",
        "AMERICAS",
        "EMEC",
        "IMEA",
        "Global"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "bakery",
        "condiments",
        "chocolate_confectionery",
        "dairy",
        "ice_cream",
        "meat",
        "oils_fats",
        "plant_based",
        "rutf_rusf",
        "needs_human_review"
      ],
      "description": "Canonical Palsgaard solution key for this product example"
    },
    "category_ai_proposed": {
      "type": "string",
      "description": "Pre-migration category value preserved for audit. Set during Phase 3 data migration."
    },
    "sub_category": {
      "type": "string"
    },
    "analyst_framing": {
      "type": "string",
      "description": "The headline/description the Mintel analyst gave this example"
    },
    "analyst_quote": {
      "type": "string",
      "description": "Verbatim 1-2 sentence description from the report. Maximum 2 sentences."
    },
    "page_ref": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "flavours": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "format_notes": {
      "type": "string"
    },
    "mintel_section_heading": {
      "type": "string"
    },
    "mintel_trend_label": {
      "type": "string"
    },
    "extraction_confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "linked_trend_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trend_links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "trend_id": {
            "type": "string"
          },
          "trend_name": {
            "type": "string"
          },
          "trend_type": {
            "type": "string",
            "enum": [
              "global",
              "mega"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "confidence_score": {
            "type": "number"
          },
          "reasoning": {
            "type": "string"
          },
          "matched_keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "review_status": {
            "type": "string",
            "enum": [
              "auto_applied",
              "pending",
              "approved",
              "rejected"
            ]
          },
          "linked_at": {
            "type": "string",
            "format": "date-time"
          },
          "reviewed_at": {
            "type": "string",
            "format": "date-time"
          },
          "reviewed_by": {
            "type": "string"
          }
        }
      }
    },
    "rejected_link_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "trend_id": {
            "type": "string"
          },
          "trend_name": {
            "type": "string"
          },
          "matched_keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "llm_verdict": {
            "type": "string"
          },
          "llm_reasoning": {
            "type": "string"
          },
          "llm_score": {
            "type": "number"
          },
          "rejected_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "image_url": {
      "type": "string"
    },
    "extracted_at": {
      "type": "string",
      "format": "date-time"
    },
    "extracted_via_run_id": {
      "type": "string"
    }
  }
}