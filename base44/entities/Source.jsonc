{
  "name": "Source",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Associated project ID (optional for shared sources)"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "mintel",
        "market_intel",
        "gnpd",
        "report",
        "url",
        "knowledge",
        "other"
      ],
      "description": "Type of source"
    },
    "classification": {
      "type": "object",
      "description": "LLM auto-classification record set at intake. Every non-GNPD source created via the unified intake must have one.",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "classifying",
            "auto_applied",
            "pending",
            "confirmed",
            "corrected",
            "failed"
          ]
        },
        "proposed_source_type": {
          "type": "string",
          "enum": [
            "knowledge",
            "mintel",
            "market_intel",
            "url"
          ]
        },
        "document_type": {
          "type": "string"
        },
        "category_relevance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "region_signal": {
          "type": "string"
        },
        "confidence": {
          "type": "number"
        },
        "reasoning": {
          "type": "string"
        },
        "classified_at": {
          "type": "string",
          "format": "date-time"
        },
        "decided_by": {
          "type": "string"
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "extraction_quality_flag": {
      "type": "string",
      "enum": [
        "non_food_contamination",
        "low_relevance",
        "duplicate_content",
        "needs_re_extraction"
      ],
      "description": "Quality flag set when the source has known extraction issues. non_food_contamination = source generated non-food ExpertExamples (extractor was too greedy on cross-domain content). Prevents further auto-extraction until reviewed."
    },
    "knowledge_subtype": {
      "type": "string",
      "enum": [
        "product_sheet",
        "technical_doc",
        "capability_overview",
        "case_study",
        "certification",
        "sustainability",
        "application_note",
        "webpage_snapshot",
        "pws",
        "other"
      ]
    },
    "owner_org": {
      "type": "string",
      "default": "Palsgaard"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "org_shared",
        "project_only"
      ],
      "default": "org_shared"
    },
    "allowed_use": {
      "type": "string",
      "enum": [
        "capability_proof_only",
        "evidence",
        "framing",
        "reference",
        "forbidden"
      ],
      "default": "capability_proof_only"
    },
    "folder_path": {
      "type": "string"
    },
    "relative_path": {
      "type": "string"
    },
    "last_reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_owner": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "REPORT",
        "INDUSTRY TREND",
        "WEBINAR",
        "PRESENTATION",
        "WHITEPAPER",
        "PWS",
        "OTHER"
      ]
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "publisher": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "date_published": {
      "type": "string",
      "format": "date"
    },
    "date_published_source": {
      "type": "string",
      "enum": [
        "extracted",
        "manual_override"
      ]
    },
    "date_published_original_extracted": {
      "type": "string",
      "format": "date"
    },
    "date_published_override_reason": {
      "type": "string"
    },
    "date_published_last_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "date_published_updated_by": {
      "type": "string"
    },
    "coverage_period": {
      "type": "string"
    },
    "pipeline_stage": {
      "type": "string",
      "enum": [
        "uploaded",
        "needs_classification",
        "extracting",
        "metadata_extracted",
        "extracted",
        "gnpd_ready",
        "skipped",
        "failed"
      ]
    },
    "review_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ]
    },
    "failure_reason": {
      "type": "string"
    },
    "skip_reason": {
      "type": "string"
    },
    "retry_count": {
      "type": "number"
    },
    "last_retry_at": {
      "type": "string",
      "format": "date-time"
    },
    "stuck_recovery_count": {
      "type": "number"
    },
    "last_stuck_recovery_at": {
      "type": "string",
      "format": "date-time"
    },
    "excerpts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "market_signal": {
            "type": "string"
          },
          "customer_pain": {
            "type": "string"
          },
          "palsgaard_angle": {
            "type": "string"
          },
          "has_direct_role": {
            "type": "boolean"
          },
          "capability_area": {
            "type": "string",
            "enum": [
              "sustainability",
              "texture_quality",
              "cost_efficiency",
              "compliance_regulatory",
              "new_product_development",
              "food_safety",
              "supply_chain",
              "plant_based",
              "general"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "relevance_score": {
            "type": "number",
            "description": "0-100: commercial market-signal value for TrendPals (category movement, consumer driver, regional expression, competitive activity). Ingredient presence neither raises nor lowers this score."
          },
          "quality_score": {
            "type": "number",
            "description": "0-100: specificity and evidence strength of the excerpt itself (concrete claim, figure, named brand/launch/region, quoted statistic vs. boilerplate/filler)."
          },
          "signal_type": {
            "type": "string",
            "enum": [
              "consumer_driver",
              "category_movement",
              "regional_expression",
              "competitive_activity",
              "other"
            ],
            "description": "The kind of market signal this excerpt carries. Locked enum. Unknown/missing at write-time normalizes to 'other'."
          },
          "promotion_status": {
            "type": "string",
            "enum": [
              "promoted",
              "demoted",
              "pending_review"
            ],
            "description": "Non-destructive verification result. promoted = clears both thresholds and feeds downstream report context. demoted = stored but below threshold, excluded from report context. pending_review = score missing/out-of-range, needs human review. Only 'promoted' excerpts feed report token spend."
          },
          "promotion_reason": {
            "type": "string",
            "description": "Short machine-written explanation of the promotion_status decision (e.g. 'promoted', 'quality below threshold (52 < 65)', 'score missing or out of range')."
          },
          "source_quote": {
            "type": "string"
          },
          "category_relevance": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Canonical Palsgaard solution keys this excerpt applies to"
          },
          "regions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Canonical region keys explicitly mentioned or implied in this excerpt (aspac, europe, north_america, latam, mena, sub_saharan_africa). Empty array if the excerpt is global or mentions no region. Existing excerpts may lack this field \u2014 readers must treat missing as []."
          },
          "page_ref": {
            "type": "string"
          },
          "trend_keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "gnpd_data": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "gnpd_headers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gnpd_row_count": {
      "type": "number"
    },
    "gnpd_preview_rows": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "gnpd_processing_status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "ready",
        "failed"
      ]
    },
    "gnpd_processing_error": {
      "type": "string"
    },
    "gnpd_mapping_status": {
      "type": "string",
      "enum": [
        "not_started",
        "detecting",
        "complete",
        "failed"
      ]
    },
    "gnpd_column_mapping": {
      "type": "object"
    },
    "gnpd_mapping_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "gnpd_mapping_error": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "uploading",
        "uploaded",
        "processing",
        "ready",
        "failed"
      ],
      "default": "queued",
      "description": "DEPRECATED \u2014 replaced by pipeline_stage + review_status"
    },
    "status_message": {
      "type": "string",
      "description": "DEPRECATED"
    },
    "processing_error": {
      "type": "string"
    },
    "upload_progress": {
      "type": "number"
    },
    "processing_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "processing_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "freshness": {
      "type": "string",
      "enum": [
        "recent",
        "aging",
        "outdated"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "bakery",
        "condiments",
        "chocolate_confectionery",
        "dairy",
        "ice_cream",
        "meat",
        "oils_fats",
        "plant_based",
        "rutf_rusf",
        "cross_industry",
        "out_of_scope",
        "needs_human_review"
      ],
      "description": "Canonical Palsgaard solution key. cross_industry = consumer-trend / cross-industry sources that cannot be tied to a single industry (e.g. Mintel consumer trend reports, ingredient watch reports). Null for genuinely cross-category sources \u2014 use category_relevance[] instead."
    },
    "category_ai_proposed": {
      "type": "string",
      "description": "Original AI-proposed category value before human correction."
    },
    "category_relevance": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Canonical Palsgaard solution keys this source is relevant to."
    },
    "main_group": {
      "type": "string",
      "enum": [
        "Food",
        "BSA"
      ]
    },
    "region_code": {
      "type": "string",
      "enum": [
        "ASPAC",
        "AMERICAS",
        "EMEC",
        "IMEA",
        "Global"
      ]
    },
    "coverage_regions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Commercial region keys (aspac, americas, emec, imea) this source covers. A source 'covers' a region if its data scope includes that region \u2014 regardless of whether it mentions it positively. Empty = coverage unknown (legacy). ['aspac','americas','emec','imea'] = global coverage."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suggested_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trust_tier": {
      "type": "string",
      "enum": [
        "approved",
        "high",
        "medium",
        "low",
        "draft",
        "external_reference"
      ],
      "default": "medium",
      "description": "DEPRECATED \u2014 replaced by review_status"
    },
    "usage_permission": {
      "type": "string",
      "enum": [
        "evidence",
        "framing",
        "reference",
        "forbidden"
      ],
      "default": "evidence"
    },
    "notes": {
      "type": "string"
    },
    "is_archived": {
      "type": "boolean",
      "default": false
    },
    "subcategory": {
      "type": "string"
    },
    "file_size": {
      "type": "number"
    },
    "snapshot_url": {
      "type": "string"
    },
    "file_hash": {
      "type": "string"
    },
    "normalized_url": {
      "type": "string"
    },
    "first_page_fingerprint": {
      "type": "string"
    },
    "metadata_extraction": {
      "type": "object"
    },
    "upload_batch_id": {
      "type": "string"
    },
    "ai_summary": {
      "type": "string"
    },
    "rag_processed": {
      "type": "boolean",
      "default": false,
      "description": "DEPRECATED \u2014 replaced by pipeline_stage"
    },
    "rag_excerpt_count": {
      "type": "number"
    },
    "mintel_chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "chunk_id": {
            "type": "string"
          },
          "chapter_title": {
            "type": "string"
          },
          "chapter_index": {
            "type": "number"
          },
          "text": {
            "type": "string"
          },
          "statistics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "stat": {
                  "type": "string"
                },
                "context": {
                  "type": "string"
                },
                "geography": {
                  "type": "string"
                },
                "year": {
                  "type": "string"
                }
              }
            }
          },
          "key_insights": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "category_tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "trend_signals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "mintel_chunking_status": {
      "type": "string",
      "enum": [
        "not_applicable",
        "pending",
        "ready",
        "failed"
      ],
      "default": "not_applicable"
    },
    "source_report_id": {
      "type": "string",
      "description": "ID of the Report record this source was uploaded from (set when a final report file is re-ingested as a knowledge source)."
    },
    "source_project_id": {
      "type": "string",
      "description": "ID of the Project this source was re-ingested from. Denormalized from source_report_id for easier filtering."
    },
    "source_type_ai_proposed": {
      "type": "string",
      "description": "AI-proposed source_type that differs from the current value. Awaiting human confirmation."
    }
  },
  "required": [
    "source_type",
    "title"
  ]
}