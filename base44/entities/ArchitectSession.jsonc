{
  "name": "ArchitectSession",
  "type": "object",
  "description": "A persisted Report Architect (Beta) chat session \u2014 transcript, contract, deck, and linked saved report.",
  "properties": {
    "owner_email": {
      "type": "string",
      "description": "Email of the user who ran this session. Used for owner-scoped access."
    },
    "owner_name": {
      "type": "string",
      "description": "Display name of the user who ran this session."
    },
    "session_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the chat session began (client-side session start)."
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the most recent message in the transcript."
    },
    "messages": {
      "type": "array",
      "description": "Stored transcript, capped for entity size limits.",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "message_count": {
      "type": "number",
      "description": "Number of stored messages."
    },
    "contract": {
      "type": "object",
      "additionalProperties": true,
      "description": "Brief contract derived during the conversation."
    },
    "slides": {
      "type": "array",
      "description": "Current working deck snapshot, including unsaved rebuilds.",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "deck_state": {
      "type": "string",
      "enum": [
        "none",
        "draft",
        "saved"
      ],
      "description": "Whether the working deck is absent, an unsaved draft, or the linked saved report. Missing on legacy sessions; load linked report when available."
    },
    "title": {
      "type": "string",
      "description": "Session title derived from the contract."
    },
    "category": {
      "type": "string",
      "description": "Primary canonical Palsgaard category."
    },
    "region": {
      "type": "string",
      "description": "Canonical region code."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "converted"
      ],
      "default": "active",
      "description": "converted means a report was saved; later working changes are tracked by deck_state."
    },
    "linked_report_id": {
      "type": "string",
      "description": "Latest saved Report id."
    },
    "linked_project_id": {
      "type": "string",
      "description": "Project id created alongside the saved report."
    }
  },
  "required": [
    "owner_email",
    "session_started_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}