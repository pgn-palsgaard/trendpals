{
  "name": "TrendCandidate",
  "type": "object",
  "required": [
    "project_id",
    "trend_name"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Associated project ID"
    },
    "global_trend_id": {
      "type": "string",
      "description": "Reference to the GlobalTrend this selection points to. TrendCandidate is a thin selection layer \u2014 report content comes from the GlobalTrend record."
    },
    "project_notes": {
      "type": "string",
      "description": "Optional project-specific notes on why this trend was selected / how to angle it"
    },
    "migration_status": {
      "type": "string",
      "enum": [
        "mapped",
        "unmapped",
        "legacy"
      ],
      "description": "Migration state: 'mapped' = linked to a GlobalTrend, 'unmapped' = no confident GlobalTrend match found (needs human review), 'legacy' = pre-migration record"
    },
    "trend_name": {
      "type": "string",
      "description": "Trend name (max 5 words)"
    },
    "is_selected": {
      "type": "boolean",
      "default": false
    },
    "is_excluded": {
      "type": "boolean",
      "default": false
    },
    "exclusion_reason": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "primary",
        "secondary"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "description": "Evidence strength"
    },
    "market_signal": {
      "type": "string",
      "description": "DEPRECATED \u2014 content now lives on the GlobalTrend record"
    },
    "whats_changing": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "DEPRECATED \u2014 content now lives on the GlobalTrend record"
    },
    "why_now": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "DEPRECATED \u2014 content now lives on the GlobalTrend record"
    },
    "customer_pains": {
      "type": "array",
      "description": "DEPRECATED \u2014 content now lives on the GlobalTrend record",
      "items": {
        "type": "object",
        "properties": {
          "pain": {
            "type": "string"
          },
          "palsgaard_can_help": {
            "type": "boolean"
          },
          "palsgaard_angle": {
            "type": "string"
          },
          "expert_only": {
            "type": "boolean",
            "default": false
          },
          "capability_area": {
            "type": "string",
            "enum": [
              "sustainability",
              "texture_quality",
              "cost_efficiency",
              "compliance_regulatory",
              "new_product_development",
              "food_safety",
              "supply_chain",
              "plant_based",
              "general"
            ]
          }
        }
      }
    },
    "conversation_openers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "DEPRECATED \u2014 generated at report time"
    },
    "evidence_anchors": {
      "type": "object",
      "description": "Links to supporting evidence including PWS insights",
      "properties": {
        "gnpd_product_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mintel_excerpts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pws_insight_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "signals_dictionary": {
      "type": "object",
      "properties": {
        "claim_cues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "format_cues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_have_signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nice_to_have_signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "what_could_be_wrong": {
      "type": "string",
      "description": "Self-critique: where might this trend analysis be off?"
    }
  }
}