{
  "name": "TrendCandidate",
  "type": "object",
  "properties": {
    "confidence": {
      "description": "Evidence strength",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "type": "string"
    },
    "conversation_openers": {
      "description": "2-3 open questions to start a customer conversation around this trend",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "customer_pains": {
      "description": "Customer pains this trend creates, each with Palsgaard angle where relevant",
      "items": {
        "properties": {
          "capability_area": {
            "enum": [
              "sustainability",
              "texture_quality",
              "cost_efficiency",
              "compliance_regulatory",
              "new_product_development",
              "food_safety",
              "supply_chain",
              "plant_based",
              "general"
            ],
            "type": "string"
          },
          "expert_only": {
            "default": false,
            "description": "True if this is valuable expert framing even without a Palsgaard product",
            "type": "boolean"
          },
          "pain": {
            "description": "The specific challenge or pain point for the customer",
            "type": "string"
          },
          "palsgaard_angle": {
            "description": "How Palsgaard can help address this pain \u2014 NO product names or dosage figures",
            "type": "string"
          },
          "palsgaard_can_help": {
            "description": "True if Palsgaard has relevant expertise or capability",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "evidence_anchors": {
      "description": "Links to supporting evidence including PWS insights",
      "properties": {
        "gnpd_product_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "mintel_excerpts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "pws_insight_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "exclusion_reason": {
      "type": "string"
    },
    "is_excluded": {
      "default": false,
      "type": "boolean"
    },
    "is_selected": {
      "default": false,
      "type": "boolean"
    },
    "market_signal": {
      "description": "What is happening in the market \u2014 the observable trend or shift",
      "type": "string"
    },
    "priority": {
      "enum": [
        "primary",
        "secondary"
      ],
      "type": "string"
    },
    "project_id": {
      "description": "Associated project ID",
      "type": "string"
    },
    "signals_dictionary": {
      "properties": {
        "claim_cues": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "exclusions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "format_cues": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "keywords": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "must_have_signals": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "nice_to_have_signals": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "trend_name": {
      "description": "Trend name (max 5 words)",
      "type": "string"
    },
    "what_could_be_wrong": {
      "description": "Self-critique: where might this trend analysis be off?",
      "type": "string"
    },
    "whats_changing": {
      "description": "2-4 bullets on what is changing for food manufacturers in this category",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "why_now": {
      "description": "1-2 bullets on why this trend is relevant right now",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "trend_name"
  ]
}