{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Project name"
    },
    "category": {
      "type": "string",
      "enum": [
        "bakery",
        "condiments",
        "chocolate_confectionery",
        "dairy",
        "ice_cream",
        "meat",
        "oils_fats",
        "plant_based",
        "rutf_rusf",
        "needs_human_review"
      ],
      "description": "Canonical Palsgaard solution key for this project's focus area"
    },
    "category_ai_proposed": {
      "type": "string",
      "description": "Pre-migration category value preserved for audit. Set during Phase 3 data migration."
    },
    "region_code": {
      "type": "string",
      "enum": [
        "ASPAC",
        "AMERICAS",
        "EMEC",
        "IMEA",
        "Global"
      ],
      "description": "Canonical region code"
    },
    "generated_by": {
      "type": "string",
      "enum": [
        "manual",
        "architect"
      ],
      "default": "manual",
      "description": "How the project was created. architect = auto-created by the Report Architect agent when saving a chat-built deck. manual = created by a user in the project workspace."
    },
    "customer_name": {
      "type": "string"
    },
    "audience": {
      "type": "string",
      "default": "Industrial manufacturers"
    },
    "objective": {
      "type": "string"
    },
    "specific_focus": {
      "type": "string"
    },
    "topics_to_avoid": {
      "type": "string"
    },
    "trend_time_window": {
      "type": "string",
      "enum": [
        "last 6 months",
        "last 12 months",
        "last 24 months",
        "last 36 months"
      ],
      "default": "last 24 months"
    },
    "meeting_context": {
      "type": "string",
      "enum": [
        "discovery",
        "innovation_day",
        "technical_workshop",
        "other"
      ]
    },
    "customer_priorities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "draft",
        "evidence_sufficient",
        "publishable",
        "published",
        "aged"
      ],
      "default": "draft"
    },
    "selected_source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_sufficiency_score": {
      "type": "number"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "trend_analysis": {
      "type": "object"
    },
    "include_trend_analysis_in_report": {
      "type": "boolean",
      "default": false
    },
    "source_brief_id": {
      "type": "string",
      "description": "ID of the ReportRequest (brief) that originated this project, if converted from a brief."
    },
    "requester_name": {
      "type": "string",
      "description": "Name of the person who submitted the originating brief."
    },
    "requester_email": {
      "type": "string",
      "description": "Email of the person who submitted the originating brief. Optional \u2014 not all briefs include this."
    }
  },
  "required": [
    "name",
    "category",
    "region_code",
    "objective"
  ]
}