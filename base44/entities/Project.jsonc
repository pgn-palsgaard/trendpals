{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Project name"
    },
    "category": {
      "type": "string",
      "description": "Product category (e.g., Ice Cream, Bakery, Confectionery)"
    },
    "region_code": {
      "type": "string",
      "enum": [
        "ASPAC",
        "AMERICAS",
        "EMEC",
        "IMEA",
        "Global"
      ],
      "description": "Canonical region code"
    },
    "customer_name": {
      "type": "string",
      "description": "Name of the customer or company this deck is being prepared for"
    },
    "audience": {
      "type": "string",
      "default": "Industrial manufacturers",
      "description": "Target audience"
    },
    "objective": {
      "type": "string",
      "description": "Purpose or decision this deck should enable"
    },
    "specific_focus": {
      "type": "string",
      "description": "Specific angles, sub-categories, or product types to focus on (e.g., 'premium single-origin chocolate', 'low-sugar ice cream', 'high-protein bakery')"
    },
    "topics_to_avoid": {
      "type": "string",
      "description": "Topics, trends, or areas to deliberately exclude or avoid in this deck"
    },
    "trend_time_window": {
      "type": "string",
      "enum": [
        "last 6 months",
        "last 12 months",
        "last 24 months",
        "last 36 months"
      ],
      "default": "last 24 months",
      "description": "Time window for trend data to consider"
    },
    "meeting_context": {
      "type": "string",
      "enum": [
        "discovery",
        "innovation_day",
        "technical_workshop",
        "other"
      ],
      "description": "Meeting context"
    },
    "customer_priorities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Customer priorities (cost, clean label, sustainability, texture, indulgence, etc.)"
    },
    "state": {
      "type": "string",
      "enum": [
        "draft",
        "evidence_sufficient",
        "publishable",
        "published",
        "aged"
      ],
      "default": "draft",
      "description": "Current project state"
    },
    "selected_trend_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of selected trends (3-5)"
    },
    "selected_source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of selected sources from the central library"
    },
    "data_sufficiency_score": {
      "type": "number",
      "description": "Score indicating data coverage quality (0-100)"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Active warnings or no-go conditions"
    },
    "trend_analysis": {
      "type": "object",
      "description": "Stored trend analysis to be included in final report"
    },
    "include_trend_analysis_in_report": {
      "type": "boolean",
      "default": false,
      "description": "Whether to include AI trend analysis in the generated report"
    }
  },
  "required": [
    "name",
    "category",
    "region_code",
    "objective"
  ]
}