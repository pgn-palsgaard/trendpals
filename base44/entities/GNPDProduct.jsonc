{
  "name": "GNPDProduct",
  "type": "object",
  "required": [
    "gnpd_record_id",
    "product_name",
    "source_id"
  ],
  "properties": {
    "gnpd_record_id": {
      "type": "string",
      "description": "Mintel GNPD record ID \u2014 primary dedup key"
    },
    "source_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "ultimate_company": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "region_code": {
      "type": "string",
      "enum": [
        "ASPAC",
        "AMERICAS",
        "EMEC",
        "IMEA",
        "Global"
      ]
    },
    "region": {
      "type": "string",
      "description": "Canonical region key derived from the market/country field via getRegionForMarket(). One of: aspac, europe, north_america, latam, mena, sub_saharan_africa, or 'unknown' if the market is unmapped. Separate from the legacy region_code field."
    },
    "launch_date": {
      "type": "string",
      "format": "date"
    },
    "launch_type": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "description": "Raw Mintel top-level category string (preserved as-is from GNPD export)"
    },
    "sub_category": {
      "type": "string",
      "description": "Raw Mintel sub-category string (preserved as-is from GNPD export)"
    },
    "palsgaard_category": {
      "type": "string",
      "enum": [
        "bakery",
        "condiments",
        "chocolate_confectionery",
        "dairy",
        "ice_cream",
        "meat",
        "oils_fats",
        "plant_based",
        "rutf_rusf",
        "out_of_scope",
        "needs_human_review"
      ],
      "description": "Resolved Palsgaard canonical solution key, derived from the two-level Mintel mapping resolver. Set at import time and by backfill."
    },
    "product_description": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ingredients": {
      "type": "string"
    },
    "flavours": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "format_type": {
      "type": "string"
    },
    "package_type": {
      "type": "string"
    },
    "storage": {
      "type": "string"
    },
    "price_usd": {
      "type": "number"
    },
    "has_emulsifier": {
      "type": "boolean",
      "default": false
    },
    "emulsifier_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "has_palsgaard_relevance": {
      "type": "boolean",
      "default": false
    },
    "palsgaard_relevance_reason": {
      "type": "string"
    },
    "linked_trend_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_mega_trend_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trend_links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "trend_id": {
            "type": "string"
          },
          "trend_name": {
            "type": "string"
          },
          "trend_type": {
            "type": "string",
            "enum": [
              "global",
              "mega"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "confidence_score": {
            "type": "number"
          },
          "reasoning": {
            "type": "string"
          },
          "matched_keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "review_status": {
            "type": "string",
            "enum": [
              "auto_applied",
              "pending",
              "approved",
              "rejected"
            ]
          },
          "linked_at": {
            "type": "string",
            "format": "date-time"
          },
          "llm_validated_at": {
            "type": "string",
            "format": "date-time"
          },
          "reviewed_at": {
            "type": "string",
            "format": "date-time"
          },
          "reviewed_by": {
            "type": "string"
          }
        }
      }
    },
    "rejected_link_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "trend_id": {
            "type": "string"
          },
          "trend_name": {
            "type": "string"
          },
          "matched_keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "llm_verdict": {
            "type": "string"
          },
          "llm_reasoning": {
            "type": "string"
          },
          "llm_score": {
            "type": "number"
          },
          "rejected_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "support_label": {
      "type": "string",
      "enum": [
        "SUPPORTS",
        "PARTIAL",
        "NOT_SUPPORT"
      ]
    },
    "image_url": {
      "type": "string"
    },
    "mintel_record_url": {
      "type": "string"
    },
    "processing_status": {
      "type": "string",
      "enum": [
        "parsed",
        "trend_linking_pending",
        "trend_linked",
        "skipped"
      ],
      "default": "parsed"
    },
    "processing_error": {
      "type": "string"
    }
  }
}