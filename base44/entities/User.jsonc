{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user",
        "reviewer"
      ],
      "default": "user",
      "description": "App role. 'reviewer' = external SME, gated to the review portal only."
    }
  }
}