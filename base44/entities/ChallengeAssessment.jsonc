{
  "name": "ChallengeAssessment",
  "type": "object",
  "description": "Versioned advisory challenge-to-trend assessment. Never changes IndustryChallenge approval, activation, market validation or capability fit.",
  "properties": {
    "challenge_id": {
      "type": "string"
    },
    "challenge_name": {
      "type": "string"
    },
    "global_trend_id": {
      "type": "string"
    },
    "trend_name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "input_hash": {
      "type": "string"
    },
    "rubric_version": {
      "type": "string"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "job_id": {
      "type": "string"
    },
    "is_latest": {
      "type": "boolean",
      "default": true
    },
    "recommendation": {
      "type": "string",
      "enum": [
        "well_supported",
        "needs_evidence",
        "needs_refinement",
        "weak_link",
        "missing_trend"
      ]
    },
    "scores": {
      "type": "object",
      "properties": {
        "trend_fit": {
          "type": "number"
        },
        "customer_perspective": {
          "type": "number"
        },
        "specificity": {
          "type": "number"
        },
        "evidence_strength": {
          "type": "number"
        }
      }
    },
    "summary": {
      "type": "string"
    },
    "causal_chain": {
      "type": "string"
    },
    "suggested_description": {
      "type": "string"
    },
    "capability_fit_proposal": {
      "type": "string",
      "enum": [
        "strong",
        "possible",
        "none",
        "unknown"
      ]
    },
    "capability_reason": {
      "type": "string"
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "counter_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "duplicate_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "challenge_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "supports": {
            "type": "string"
          }
        }
      }
    },
    "input_manifest": {
      "type": "object",
      "additionalProperties": true
    },
    "review_state": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed"
      ],
      "default": "pending"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_note": {
      "type": "string"
    }
  },
  "required": [
    "challenge_id",
    "input_hash",
    "rubric_version",
    "evaluated_at",
    "recommendation",
    "review_state"
  ]
}