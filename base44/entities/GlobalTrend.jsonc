{
  "name": "GlobalTrend",
  "type": "object",
  "required": [
    "trend_name",
    "category"
  ],
  "properties": {
    "trend_name": {
      "type": "string",
      "description": "e.g. Plant-based indulgence parity"
    },
    "category": {
      "type": "string",
      "enum": [
        "bakery",
        "condiments",
        "chocolate_confectionery",
        "dairy",
        "ice_cream",
        "meat",
        "oils_fats",
        "plant_based",
        "rutf_rusf",
        "needs_human_review"
      ],
      "description": "Canonical Palsgaard solution key for this trend"
    },
    "category_ai_proposed": {
      "type": "string",
      "description": "Pre-migration category value preserved for audit. Set during Phase 3 data migration."
    },
    "mega_trend": {
      "type": "string",
      "description": "Display label of the driver this trend belongs to. Matches MegaTrend.mega_trend_name."
    },
    "driver_key": {
      "type": "string",
      "description": "Stable join key to MegaTrend.key"
    },
    "overlap_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "overlapping_trend_id": {
            "type": "string"
          },
          "overlap_score": {
            "type": "number"
          },
          "shared_keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "detected_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "confirmed_distinct",
              "merge_recommended",
              "resolved"
            ]
          }
        }
      }
    },
    "description": {
      "type": "string",
      "description": "Long-form narrative description of the trend"
    },
    "market_signal": {
      "type": "string",
      "description": "The global signal written outside-in (short \u2014 1-3 sentences)"
    },
    "whats_changing": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "why_now": {
      "type": "string"
    },
    "capability_area": {
      "type": "string",
      "enum": [
        "sustainability",
        "texture_quality",
        "cost_efficiency",
        "compliance_regulatory",
        "new_product_development",
        "food_safety",
        "supply_chain",
        "plant_based",
        "general"
      ]
    },
    "trend_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "regional_manifestations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "region": {
            "type": "string"
          },
          "signal": {
            "type": "string"
          },
          "intensity": {
            "type": "string",
            "enum": [
              "strong",
              "moderate",
              "emerging"
            ]
          },
          "gnpd_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "last_updated": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "mintel",
              "trade_press",
              "industry_data",
              "research_report",
              "internal_palsgaard",
              "gnpd",
              "web_article",
              "press_release",
              "other"
            ]
          },
          "url": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "source_id": {
            "type": "string"
          },
          "key_finding": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "auto_linked": {
            "type": "boolean"
          },
          "linked_via_run_id": {
            "type": "string"
          },
          "review_status": {
            "type": "string",
            "enum": [
              "auto_applied",
              "pending",
              "approved",
              "rejected",
              "reverted",
              "manual_curated"
            ]
          },
          "link_confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "confidence_score": {
            "type": "number"
          },
          "confidence_reasoning": {
            "type": "string"
          },
          "keyword_overlap": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "source_references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  }
}