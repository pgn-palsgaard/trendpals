{
  "name": "GlobalTrend",
  "type": "object",
  "required": [
    "trend_name",
    "category"
  ],
  "properties": {
    "trend_name": {
      "type": "string",
      "description": "e.g. Plant-based indulgence parity"
    },
    "category": {
      "type": "string",
      "enum": [
        "Ice Cream",
        "Dairy",
        "Confectionery",
        "Bakery",
        "Spreads",
        "Dressings",
        "Other"
      ]
    },
    "mega_trend": {
      "type": "string",
      "enum": [
        "Value",
        "Wellbeing",
        "Surroundings",
        "Experiences",
        "Rights",
        "Identity"
      ],
      "description": "Display label of the driver this trend belongs to. Matches MegaTrend.mega_trend_name."
    },
    "driver_key": {
      "type": "string",
      "description": "Stable join key to MegaTrend.key (e.g. 'value', 'wellbeing'). Use this for all programmatic links \u2014 renaming a driver's display label never changes this key."
    },
    "overlap_flags": {
      "type": "array",
      "description": "Auto-detected same-category keyword overlap candidates. Human-resolved \u2014 never auto-merged.",
      "items": {
        "type": "object",
        "properties": {
          "overlapping_trend_id": {
            "type": "string"
          },
          "overlap_score": {
            "type": "number"
          },
          "shared_keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "detected_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "confirmed_distinct",
              "merge_recommended",
              "resolved"
            ]
          }
        }
      }
    },
    "description": {
      "type": "string",
      "description": "Long-form narrative description of the trend \u2014 3-5 paragraphs covering context, drivers, evidence, market dynamics, and what it means for ingredient suppliers. The 'read-up' view shown when opening the trend detail page."
    },
    "market_signal": {
      "type": "string",
      "description": "The global signal written outside-in (short \u2014 1-3 sentences)"
    },
    "whats_changing": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "3-4 bullets on what is shifting globally"
    },
    "why_now": {
      "type": "string",
      "description": "Why this trend is relevant right now"
    },
    "capability_area": {
      "type": "string",
      "enum": [
        "sustainability",
        "texture_quality",
        "cost_efficiency",
        "compliance_regulatory",
        "new_product_development",
        "food_safety",
        "supply_chain",
        "plant_based",
        "general"
      ]
    },
    "trend_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "regional_manifestations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "region": {
            "type": "string"
          },
          "signal": {
            "type": "string",
            "description": "How this global trend shows up in this region"
          },
          "intensity": {
            "type": "string",
            "enum": [
              "strong",
              "moderate",
              "emerging"
            ]
          },
          "gnpd_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "last_updated": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "sources": {
      "type": "array",
      "description": "Structured source citations backing this trend. Entries may be manually curated or added by the Source Processor agent \u2014 see review_status to distinguish.",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Title or headline of the source"
          },
          "publisher": {
            "type": "string",
            "description": "e.g. Mintel, FoodNavigator, Innova Market Insights, Datassential, IDFA, Future Market Insights, Dairy Reporter"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "mintel",
              "trade_press",
              "industry_data",
              "research_report",
              "internal_palsgaard",
              "gnpd",
              "web_article",
              "press_release",
              "other"
            ]
          },
          "url": {
            "type": "string",
            "description": "Link to the source if available"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Publication date"
          },
          "source_id": {
            "type": "string",
            "description": "Reference to a Base44 Source entity ID when the source lives in the Source library"
          },
          "key_finding": {
            "type": "string",
            "description": "What this source contributes to the trend \u2014 1-2 sentences"
          },
          "quote": {
            "type": "string",
            "description": "Optional short verbatim quote or data point from the source"
          },
          "auto_linked": {
            "type": "boolean",
            "description": "True if added by the Source Processor agent (auto-applied or auto-proposed). False or absent for manually curated entries."
          },
          "linked_via_run_id": {
            "type": "string",
            "description": "Reference to the ProcessingRun.id that created this entry (audit trail)"
          },
          "review_status": {
            "type": "string",
            "enum": [
              "auto_applied",
              "pending",
              "approved",
              "rejected",
              "reverted",
              "manual_curated"
            ],
            "description": "Governance state."
          },
          "link_confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "confidence_score": {
            "type": "number"
          },
          "confidence_reasoning": {
            "type": "string"
          },
          "keyword_overlap": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "source_references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  }
}