{
  "name": "GlobalTrend",
  "type": "object",
  "required": [
    "trend_name",
    "category"
  ],
  "properties": {
    "trend_name": {
      "type": "string",
      "description": "e.g. Plant-based indulgence parity"
    },
    "category": {
      "type": "string",
      "enum": [
        "Ice Cream",
        "Dairy",
        "Confectionery",
        "Bakery",
        "Spreads",
        "Dressings",
        "Other"
      ]
    },
    "mega_trend": {
      "type": "string",
      "enum": [
        "GLP-1",
        "Cost reformulation",
        "Sustainability",
        "Plant-based parity",
        "Functional & gut health",
        "Premium indulgence",
        "Protein-as-default"
      ],
      "description": "Cross-category consumer mega-trend this trend belongs to (optional)"
    },
    "description": {
      "type": "string",
      "description": "Long-form narrative description of the trend \u2014 3-5 paragraphs covering context, drivers, evidence, market dynamics, and what it means for ingredient suppliers. The 'read-up' view shown when opening the trend detail page."
    },
    "market_signal": {
      "type": "string",
      "description": "The global signal written outside-in (short \u2014 1-3 sentences)"
    },
    "whats_changing": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "3-4 bullets on what is shifting globally"
    },
    "why_now": {
      "type": "string",
      "description": "Why this trend is relevant right now"
    },
    "capability_area": {
      "type": "string",
      "enum": [
        "sustainability",
        "texture_quality",
        "cost_efficiency",
        "compliance_regulatory",
        "new_product_development",
        "food_safety",
        "supply_chain",
        "plant_based",
        "general"
      ]
    },
    "trend_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "regional_manifestations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "region": {
            "type": "string"
          },
          "signal": {
            "type": "string",
            "description": "How this global trend shows up in this region"
          },
          "intensity": {
            "type": "string",
            "enum": [
              "strong",
              "moderate",
              "emerging"
            ]
          },
          "gnpd_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "last_updated": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "sources": {
      "type": "array",
      "description": "Structured source citations backing this trend.",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Title or headline of the source"
          },
          "publisher": {
            "type": "string",
            "description": "e.g. Mintel, FoodNavigator, Innova Market Insights, Datassential, IDFA, Future Market Insights, Dairy Reporter"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "mintel",
              "trade_press",
              "industry_data",
              "research_report",
              "internal_palsgaard",
              "gnpd",
              "web_article",
              "press_release",
              "other"
            ]
          },
          "url": {
            "type": "string",
            "description": "Link to the source if available"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Publication date"
          },
          "source_id": {
            "type": "string",
            "description": "Reference to a Base44 Source entity ID when the source lives in the Source library"
          },
          "key_finding": {
            "type": "string",
            "description": "What this source contributes to the trend \u2014 1-2 sentences"
          },
          "quote": {
            "type": "string",
            "description": "Optional short verbatim quote or data point from the source"
          }
        }
      }
    },
    "source_references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  }
}