{
  "name": "ReportRequest",
  "type": "object",
  "properties": {
    "requester_name": {
      "type": "string",
      "description": "Name of the person submitting the request"
    },
    "requester_email": {
      "type": "string",
      "description": "Email of the requester"
    },
    "account": {
      "type": "string",
      "description": "Customer account / company name"
    },
    "region": {
      "type": "string",
      "enum": [
        "ASPAC",
        "AMERICAS",
        "EMEC",
        "IMEA",
        "Global"
      ],
      "description": "Canonical region code (aligned with Palsgaard sales regions)"
    },
    "deadline": {
      "type": "string",
      "format": "date",
      "description": "Requested delivery deadline"
    },
    "categories": {
      "type": "string",
      "description": "Comma-separated list of food categories"
    },
    "purpose": {
      "type": "string",
      "description": "Purpose or goal of the report"
    },
    "challenges": {
      "type": "string",
      "description": "Customer challenges or focus areas"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "jtbd": {
      "type": "string",
      "enum": [
        "prepare_customer_meeting",
        "build_trend_deck",
        "understand_market",
        "support_innovation_pipeline",
        "other"
      ],
      "description": "Job to be done selected on the SubmitBrief page"
    },
    "external_data_needed": {
      "type": "string",
      "description": "External data the requester flagged as needed (e.g. specific Mintel reports)"
    },
    "suggested_source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Source IDs suggested during brief intake"
    },
    "selected_trend_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "GlobalTrend IDs the requester confirmed as relevant during the Trend Relevance Check step"
    },
    "selected_trend_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Snapshot of confirmed trend names at submission time, for display"
    },
    "conversation_log": {
      "type": "array",
      "description": "Full AI intake conversation transcript",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "in_progress",
        "delivered",
        "unlinked"
      ],
      "default": "new",
      "description": "Current status of the request. 'unlinked' = the linked project was deleted, brief is available again for a new project."
    },
    "project_id": {
      "type": "string",
      "description": "Linked Project ID once converted"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the brief was submitted"
    }
  },
  "required": [
    "requester_name",
    "account"
  ]
}