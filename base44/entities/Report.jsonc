{
  "name": "Report",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Associated project ID"
    },
    "title": {
      "type": "string",
      "description": "Report title"
    },
    "category": {
      "type": "string",
      "description": "Category (copied from project)"
    },
    "region": {
      "type": "string",
      "description": "Coarse commercial region code (EMEC/ASPAC/AMERICAS/IMEA). NULL when the brief spans more than one code \u2014 a mixed scope is never labelled 'Global', because 'Global' reads as worldwide coverage the report does not have. NEVER use this field as a filter for evidence scoping; the authoritative scope is evidence_gate.country_allow_list."
    },
    "region_display_label": {
      "type": "string",
      "description": "Human-readable scope label for headers and exports, e.g. 'Europe, Turkey, CIS countries (49 markets)'. DISPLAY ONLY \u2014 free text, never a query value, never parsed. Anything that needs the real scope must read evidence_gate.country_allow_list."
    },
    "excluded_countries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Countries explicitly excluded from evidence scope. Written by the architect at brief intake. Fail-closed: gate removes these from the allow-list after all other resolution. Never inferred from free text."
    },
    "evidence_gate_rendered_by_country": {
      "type": "object",
      "additionalProperties": true,
      "default": {},
      "description": "Country \u2192 count of rendered gnpd_examples. Written at save time. Never empty on a report with gnpd_examples."
    },
    "preflight_failed": {
      "type": "boolean",
      "default": false,
      "description": "Phase 6 \u2014 true when the last export attempt was blocked by the regional-containment pre-flight. Set on the report so the UI can state the reason instead of the user meeting a silent failure. Cleared on the next export attempt that passes."
    },
    "preflight_error": {
      "type": "string",
      "description": "Human-readable reason the export pre-flight blocked this report, including the offending countries and their rendered counts."
    },
    "generated_by": {
      "type": "string",
      "enum": [
        "manual",
        "architect"
      ],
      "default": "manual",
      "description": "How the report was produced. architect = built automatically by the Report Architect agent chat flow. manual = assembled in the project workspace."
    },
    "analysis_mode": {
      "type": "string",
      "enum": [
        "standard",
        "product_first"
      ],
      "description": "How the report's trends were determined. standard = manually selected trends. product_first = KAM approach \u2014 trends derived automatically from the account's own GNPD launch history (outside-in, product-led analysis)."
    },
    "slides": {
      "type": "array",
      "description": "Complete slide deck (5-10 slides)",
      "items": {
        "type": "object",
        "properties": {
          "slide_number": {
            "type": "number"
          },
          "slide_name": {
            "type": "string"
          },
          "slide_type": {
            "type": "string",
            "description": "Rendering hint: content, section_header, briefing_context, methodology, product_export."
          },
          "title": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          },
          "market_signal": {
            "type": "string",
            "description": "What is happening in the market \u2014 1-2 sentences, external signals only"
          },
          "why_it_may_matter": {
            "type": "string",
            "description": "The commercial implication of the observation for a manufacturer deciding now. Observation framing, never prescription."
          },
          "formulation_questions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The technical / application questions the market observation raises (dough rheology, hydration balance, gluten dilution, staling, mouthfeel and similar). Turns a market observation into a technical conversation."
          },
          "customer_pains": {
            "type": "array",
            "description": "2-3 specific challenges this creates for food manufacturers",
            "items": {
              "type": "object",
              "properties": {
                "pain": {
                  "type": "string"
                },
                "palsgaard_can_help": {
                  "type": "boolean"
                },
                "palsgaard_angle": {
                  "type": "string",
                  "description": "How Palsgaard expertise addresses this \u2014 NO product names or dosages"
                },
                "expert_only": {
                  "type": "boolean",
                  "description": "True if valuable insight even without Palsgaard product"
                }
              }
            }
          },
          "conversation_openers": {
            "type": "array",
            "description": "1-2 open questions to invite customer into dialogue",
            "items": {
              "type": "string"
            }
          },
          "supporting_data": {
            "type": "array",
            "description": "Stats or market data that ground the slide \u2014 sourced from Mintel or GNPD",
            "items": {
              "type": "object",
              "properties": {
                "stat": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "geography": {
                  "type": "string"
                }
              }
            }
          },
          "gnpd_examples": {
            "type": "array",
            "description": "2-4 real product launches that illustrate the trend",
            "items": {
              "type": "string"
            }
          },
          "evidence_footer": {
            "type": "string"
          },
          "image_placements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence_pack": {
      "type": "array",
      "description": "5-10 evidence bullets linking market signals to Palsgaard capability areas",
      "items": {
        "type": "object",
        "properties": {
          "signal": {
            "type": "string"
          },
          "capability_area": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          },
          "confidence": {
            "type": "string"
          }
        }
      }
    },
    "product_shortlist": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "12-20 GNPD launches with priorities and trend mappings"
    },
    "image_map": {
      "type": "object",
      "description": "Slide-by-slide image placement mapping"
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Report version number"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "aged"
      ],
      "default": "draft"
    },
    "freshness": {
      "type": "string",
      "enum": [
        "fresh",
        "use_with_caution",
        "outdated"
      ]
    },
    "selected_trends": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "executive_summary": {
      "type": "string",
      "description": "AI-generated executive summary of the report"
    },
    "evidence_gate": {
      "type": "object",
      "additionalProperties": true,
      "description": "Snapshot of the evidence gate that produced this report (beta architect only): resolved country allow-list, sequential funnel counts, actual data window, per-sub-region eligible AND rendered counts, web-signal region filter counts, exclusion counts by reason, dropped and downgraded trends. Feeds the methodology appendix and makes the report auditable. This is the authoritative scope of the report."
    },
    "validator_log": {
      "type": "object",
      "additionalProperties": true,
      "description": "Phase 7 \u2014 write-time output-validation record for this report. An EMPTY log is a valid, meaningful state: it means the deck passed with nothing rejected. Shape: { validated_at, rewrite_attempted, rewrite_succeeded, rejections: [{rule, field, why, text, phase, timestamp}], flags: [{rule, field, why, text}], rule_fire_counts: {RULE_ID: n} }.",
      "properties": {
        "validated_at": {
          "type": "string",
          "format": "date-time"
        },
        "rewrite_attempted": {
          "type": "boolean"
        },
        "rewrite_succeeded": {
          "type": "boolean"
        },
        "rejections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rule": {
                "type": "string",
                "description": "Rule ID that fired, e.g. FIG-1, ADJ-2, PRE-1, PUB-3"
              },
              "field": {
                "type": "string",
                "description": "Slide and field path the rejected string sat in"
              },
              "why": {
                "type": "string"
              },
              "text": {
                "type": "string",
                "description": "The rejected string, stored verbatim so the decision is auditable"
              },
              "phase": {
                "type": "string",
                "enum": [
                  "first_pass",
                  "after_rewrite"
                ],
                "description": "first_pass = fired on the architect's original deck. after_rewrite = still firing after the single rewrite attempt, i.e. the save was blocked."
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rule": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "why": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "rule_fire_counts": {
          "type": "object",
          "additionalProperties": true,
          "description": "Per-rule fire counts for this report, so drift can be aggregated across runs without re-parsing the entries."
        }
      }
    },
    "gamma_url": {
      "type": "string"
    },
    "gamma_pptx_url": {
      "type": "string"
    },
    "gamma_pdf_url": {
      "type": "string"
    },
    "gamma_prompt": {
      "type": "string"
    },
    "gamma_generation_id": {
      "type": "string",
      "description": "Gamma API generation job id for the current PPTX export. Used to poll generation status."
    },
    "gamma_export_status": {
      "type": "string",
      "enum": [
        "idle",
        "generating",
        "ready",
        "failed"
      ],
      "description": "Lifecycle of the Gamma PPTX export for this report."
    },
    "gamma_export_error": {
      "type": "string",
      "description": "Error message from the last failed Gamma export attempt."
    },
    "gamma_export_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the current Gamma export job was started."
    },
    "claude_pptx_url": {
      "type": "string",
      "description": "URL of the PPTX generated by the custom Palsgaard PowerPoint Claude skill."
    },
    "claude_export_status": {
      "type": "string",
      "enum": [
        "idle",
        "generating",
        "ready",
        "failed"
      ],
      "description": "Lifecycle of the Claude-skill PPTX export for this report."
    },
    "claude_export_error": {
      "type": "string",
      "description": "Error message from the last failed Claude-skill export attempt."
    },
    "claude_export_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the current Claude-skill export job was started."
    },
    "claude_export_stage": {
      "type": "string",
      "description": "Current stage of the synchronous Claude-skill export, for the UI. Values: uploading_images, building, done. Null when no export is running."
    },
    "claude_export_stage_detail": {
      "type": "string",
      "description": "One human-readable line shown live in the UI while the export runs."
    },
    "claude_export_finished_at": {
      "type": "string",
      "format": "date-time",
      "description": "Set when claude_export_status becomes ready or failed."
    },
    "claude_export_message_id": {
      "type": "string",
      "description": "Anthropic message.id of the synchronous export call, for debugging."
    },
    "claude_export_usage": {
      "type": "object",
      "additionalProperties": true,
      "description": "{ input_tokens, output_tokens } from the completed synchronous export call."
    },
    "claude_batch_id": {
      "type": "string",
      "description": "Deprecated \u2014 Message Batches path removed. Retained for historical records only. Never written by new code."
    },
    "claude_uploaded_file_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Deprecated \u2014 pack shots are now cleaned up synchronously. Retained for historical records only."
    },
    "final_pptx_url": {
      "type": "string"
    },
    "final_pdf_url": {
      "type": "string"
    },
    "final_uploaded_at": {
      "type": "string",
      "format": "date-time"
    },
    "final_uploaded_by": {
      "type": "string"
    },
    "final_uploads": {
      "type": "array",
      "description": "History of final report files uploaded (PPTX, PDF) with linked Source records for knowledge extraction.",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Public file URL"
          },
          "file_type": {
            "type": "string",
            "enum": [
              "pptx",
              "pdf",
              "other"
            ]
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time"
          },
          "uploaded_by": {
            "type": "string",
            "description": "Email of user who uploaded"
          },
          "source_id": {
            "type": "string",
            "description": "ID of the Source record created for knowledge extraction"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "project_id",
    "title",
    "category"
  ]
}