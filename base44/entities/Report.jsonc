{
  "name": "Report",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Associated project ID"
    },
    "title": {
      "type": "string",
      "description": "Report title"
    },
    "category": {
      "type": "string",
      "description": "Category copied from project"
    },
    "region": {
      "type": "string",
      "description": "Coarse commercial region code (EMEC/ASPAC/AMERICAS/IMEA). NULL when the brief spans more than one code \u2014 a mixed scope is never labelled Global. Display only; authoritative evidence scope is evidence_gate.country_allow_list."
    },
    "region_display_label": {
      "type": "string",
      "description": "Human-readable scope label for headers and exports. DISPLAY ONLY \u2014 never parsed as a query. Real scope lives in evidence_gate.country_allow_list."
    },
    "excluded_countries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Countries explicitly excluded at intake. Fail-closed removal after scope resolution; never inferred from prose."
    },
    "evidence_gate_rendered_by_country": {
      "type": "object",
      "additionalProperties": true,
      "default": {},
      "description": "Country to rendered REGIONAL GNPD count. Read-across counts belong in evidence_gate.read_across.rendered_by_country. Unresolved bindings count as regional, fail-closed."
    },
    "evidence_bindings": {
      "type": "object",
      "additionalProperties": true,
      "default": {},
      "description": "Frozen build-time citation map: id to {canonical_string, trend_id, kind: source|inline|web|gnpd}. Cross-region GNPD entries additionally carry read_across:true and original_country. Resolve against this map, never live retrieval. Web entries have empty trend_id and are exempt from XTREND-1."
    },
    "trend_status": {
      "type": "object",
      "additionalProperties": true,
      "default": {},
      "description": "Frozen per-trend {evidence_status, record_count, read_across_status, read_across_count}. Renderer owns signal annotations, never slide prose."
    },
    "preflight_failed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the last export was blocked by regional containment. Cleared on a passing export."
    },
    "preflight_error": {
      "type": "string",
      "description": "Human-readable pre-flight failure reason, offending countries and counts."
    },
    "generated_by": {
      "type": "string",
      "enum": [
        "manual",
        "architect"
      ],
      "default": "manual",
      "description": "How this report was produced."
    },
    "analysis_mode": {
      "type": "string",
      "enum": [
        "standard",
        "product_first"
      ],
      "description": "Standard trend selection or outside-in, account product-led KAM analysis."
    },
    "slides": {
      "type": "array",
      "description": "Complete ordered slide deck, including all presentation text, tables and appendices.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "slide_number": {
            "type": "number"
          },
          "slide_name": {
            "type": "string"
          },
          "slide_type": {
            "type": "string",
            "description": "Rendering hint: content, section_header, briefing_context, methodology, implications, product_export, agenda, table, imperatives."
          },
          "trend_id": {
            "type": "string",
            "description": "Exact verified trend id. Basis for citation resolution, XTREND-1 containment and computed evidence annotation."
          },
          "evidence_class": {
            "type": "string",
            "enum": [
              "regional",
              "read_across"
            ],
            "default": "regional",
            "description": "One evidence tier per slide; never mix regional and cross-region products."
          },
          "provenance_label": {
            "type": "string",
            "description": "Deterministic cross-region honesty line written by renderer, never architect."
          },
          "title": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          },
          "preheader": {
            "type": "string",
            "description": "Slide pre-header, preserved for preview and all export formats."
          },
          "category": {
            "type": "string"
          },
          "bullets_header": {
            "type": "string"
          },
          "bullets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "agenda_items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "so_what": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "hypothesis_tieback": {
            "type": "string"
          },
          "prepared_for": {
            "type": "string"
          },
          "commercial_questions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "trends_under_microscope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "strategic_implications": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Implications slides: max 4 one-line commercial observations grounded in preceding trend evidence."
          },
          "palsgaard_support": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Implications slides: max 3 one-line capability observations, no product names or dosages."
          },
          "market_signal": {
            "type": "string",
            "description": "External market observation, 1\u20132 sentences."
          },
          "why_it_may_matter": {
            "type": "string",
            "description": "Commercial implication, observation not prescription."
          },
          "formulation_questions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Technical/application questions raised by the market observation."
          },
          "customer_pains": {
            "type": "array",
            "description": "Specific manufacturer challenges.",
            "items": {
              "type": "object",
              "properties": {
                "pain": {
                  "type": "string"
                },
                "palsgaard_can_help": {
                  "type": "boolean"
                },
                "palsgaard_angle": {
                  "type": "string",
                  "description": "Capability angle, no product names or dosages."
                },
                "expert_only": {
                  "type": "boolean",
                  "description": "Valuable insight even without a Palsgaard product."
                }
              }
            }
          },
          "conversation_openers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Open questions inviting customer dialogue."
          },
          "supporting_data": {
            "type": "array",
            "description": "Source-backed market data.",
            "items": {
              "type": "object",
              "properties": {
                "stat": {
                  "type": "string"
                },
                "source_id": {
                  "type": "string",
                  "description": "Authoritative cited SRC or WEB id."
                },
                "source": {
                  "type": "string",
                  "description": "Resolved citation from evidence_bindings, never architect-authored on ID-locked decks. Legacy strings retained."
                },
                "geography": {
                  "type": "string"
                }
              }
            }
          },
          "gnpd_examples": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Real product examples prefixed by exact GNPD Record ID."
          },
          "evidence_footer": {
            "type": "string"
          },
          "image_placements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence_pack": {
      "type": "array",
      "description": "Evidence bullets linking signals to capability areas.",
      "items": {
        "type": "object",
        "properties": {
          "signal": {
            "type": "string"
          },
          "capability_area": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          },
          "confidence": {
            "type": "string"
          }
        }
      }
    },
    "product_shortlist": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "GNPD launches with priorities and trend mappings."
    },
    "image_map": {
      "type": "object",
      "description": "Slide-by-slide image placement mapping."
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "aged"
      ],
      "default": "draft"
    },
    "freshness": {
      "type": "string",
      "enum": [
        "fresh",
        "use_with_caution",
        "outdated"
      ]
    },
    "selected_trends": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "executive_summary": {
      "type": "string",
      "description": "AI-generated executive summary."
    },
    "evidence_gate": {
      "type": "object",
      "additionalProperties": true,
      "description": "Authoritative evidence scope and audit snapshot: resolved country allow-list, sequential funnel counts, actual data window, per-sub-region eligible/rendered counts, exclusions, dropped/downgraded trends and read_across block (requested, total_records, by_country, per_trend, rendered_by_country)."
    },
    "validator_log": {
      "type": "object",
      "additionalProperties": true,
      "description": "Write-time validation record. Empty log means passed with nothing rejected. Surgical rewrites only, never full-deck re-rolls.",
      "properties": {
        "validated_at": {
          "type": "string",
          "format": "date-time"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "passed",
            "warnings_only",
            "blocked"
          ],
          "description": "warnings_only means cosmetic LEN overruns knowingly saved. blocked means integrity violations and nothing saved."
        },
        "rewrite_attempts": {
          "type": "number",
          "description": "Number of surgical rewrites: 0, 1 or 2."
        },
        "rewrite_attempted": {
          "type": "boolean"
        },
        "rewrite_succeeded": {
          "type": "boolean"
        },
        "unresolvable": {
          "type": "object",
          "additionalProperties": true,
          "description": "UNRES-1 counts: total_cited, unresolved, ratio, threshold."
        },
        "rejections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rule": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "why": {
                "type": "string"
              },
              "text": {
                "type": "string",
                "description": "Verbatim rejected text."
              },
              "phase": {
                "type": "string",
                "enum": [
                  "first_pass",
                  "after_rewrite_1",
                  "after_rewrite_2",
                  "save_confirm"
                ]
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rule": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "why": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "rule_fire_counts": {
          "type": "object",
          "additionalProperties": true,
          "description": "Per-rule fire counts for drift aggregation."
        }
      }
    },
    "gamma_url": {
      "type": "string"
    },
    "gamma_pptx_url": {
      "type": "string"
    },
    "gamma_pdf_url": {
      "type": "string"
    },
    "gamma_prompt": {
      "type": "string"
    },
    "gamma_generation_id": {
      "type": "string",
      "description": "Current Gamma generation job id for polling."
    },
    "gamma_export_status": {
      "type": "string",
      "enum": [
        "idle",
        "generating",
        "ready",
        "failed"
      ]
    },
    "gamma_export_error": {
      "type": "string"
    },
    "gamma_export_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "claude_pptx_url": {
      "type": "string",
      "description": "Custom Palsgaard PowerPoint export URL."
    },
    "claude_export_status": {
      "type": "string",
      "enum": [
        "idle",
        "generating",
        "ready",
        "failed"
      ],
      "description": "Export lifecycle; stale generating jobs recovered by checkClaudePptxExport."
    },
    "claude_export_error": {
      "type": "string"
    },
    "claude_export_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "Basis for stale-state recovery."
    },
    "claude_export_stage": {
      "type": "string",
      "description": "uploading_images, building, done, or null."
    },
    "claude_export_stage_detail": {
      "type": "string",
      "description": "Live progress text, debounced at most once per 4 seconds."
    },
    "claude_export_finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "claude_export_message_id": {
      "type": "string"
    },
    "claude_export_usage": {
      "type": "object",
      "additionalProperties": true,
      "description": "Completed call input_tokens and output_tokens."
    },
    "claude_batch_id": {
      "type": "string",
      "description": "Deprecated, historical records only."
    },
    "claude_uploaded_file_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Deprecated, historical records only."
    },
    "final_pptx_url": {
      "type": "string"
    },
    "final_pdf_url": {
      "type": "string"
    },
    "final_uploaded_at": {
      "type": "string",
      "format": "date-time"
    },
    "final_uploaded_by": {
      "type": "string"
    },
    "final_uploads": {
      "type": "array",
      "description": "Final uploaded files with linked Source records for knowledge extraction.",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "file_type": {
            "type": "string",
            "enum": [
              "pptx",
              "pdf",
              "other"
            ]
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time"
          },
          "uploaded_by": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "project_id",
    "title",
    "category"
  ]
}