{
  "name": "GNPD seed trend: Beyond clean label, bakery MEA (one-off)",
  "description": "One-off: seeds 'Beyond clean label formulation' candidates onto already-linked bakery products in MEA after the trend became product_observable (2 Nov 2026). Writes pending candidates only; the drain validates them. Archive after use.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 1,
      "interval_unit": "days",
      "interval_anchor": null,
      "ends_type": "after_count",
      "ends_on_date": null,
      "ends_after_count": 1
    }
  },
  "definition": {
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "then": "end",
          "with": {
            "args": {
              "mode": "seed_trend",
              "regions": [
                "mena",
                "sub_saharan_africa"
              ],
              "source": "scheduled_resume",
              "trend_id": "6a22c9c1435c3fc217c70863"
            },
            "function_name": "revalidatePendingTrendLinks"
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "gnpd_seed_trend",
      "namespace": "base44",
      "version": "1.0"
    }
  }
}