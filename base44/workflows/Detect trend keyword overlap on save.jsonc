{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "detect_trend_keyword_overlap_on_save",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "detectTrendOverlap",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Check trend keyword overlap",
            "description": "Runs only when overlap inputs change"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": "${ .trigger.data.is_active == true and (.trigger.event_type == \"create\" or ((.trigger.changed_fields // []) | any(. == \"trend_keywords\" or . == \"category\" or . == \"is_active\"))) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "GlobalTrend"
    }
  },
  "description": "",
  "name": "Detect trend keyword overlap on save",
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "detectTrendOverlap"
  }
}