{
  "name": "GNPD trend-link drain (5min, per category)",
  "description": "Drains GNPD products in trend_linking_pending through the gated LLM trend-link validator (revalidatePendingTrendLinks), one Palsgaard category at a time. Pilot: ice_cream. Since 2 Nov 2026 the function uses Haiku 4.5, one batched call per product and 4 parallel workers. Cap raised to 200 runs.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 5,
      "interval_unit": "minutes",
      "interval_anchor": null,
      "ends_type": "after_count",
      "ends_on_date": null,
      "ends_after_count": 200
    }
  },
  "definition": {
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "then": "end",
          "with": {
            "args": {
              "category": "ice_cream",
              "source": "scheduled_resume"
            },
            "function_name": "revalidatePendingTrendLinks"
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "gnpd_trend_link_drain",
      "namespace": "base44",
      "version": "1.0"
    }
  }
}