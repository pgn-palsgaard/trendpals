{
  "name": "GNPD trend-link drain (5min, per category)",
  "description": "Drains GNPD products in trend_linking_pending through the gated LLM trend-link validator (revalidatePendingTrendLinks), scoped by category and optional regions. Currently: bakery, Middle East & Africa (mena + sub_saharan_africa). Ice cream paused 2 Nov 2026. Haiku 4.5, batched, 4 workers.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 5,
      "interval_unit": "minutes",
      "interval_anchor": null,
      "ends_type": "after_count",
      "ends_on_date": null,
      "ends_after_count": 200
    }
  },
  "definition": {
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "then": "end",
          "with": {
            "args": {
              "category": "bakery",
              "regions": [
                "mena",
                "sub_saharan_africa"
              ],
              "source": "scheduled_resume"
            },
            "function_name": "revalidatePendingTrendLinks"
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "gnpd_trend_link_drain",
      "namespace": "base44",
      "version": "1.0"
    }
  }
}