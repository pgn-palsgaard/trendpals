{
  "name": "Noise check bakery (compare, no writes)",
  "description": "No-write: re-judges 100 recent bakery verdicts with the recalibrated rule to measure how many old rejections now pass (noise check). Archive after use.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 24,
      "interval_unit": "hours",
      "interval_anchor": null,
      "ends_type": "after_count",
      "ends_on_date": null,
      "ends_after_count": 3
    }
  },
  "definition": {
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "then": "end",
          "with": {
            "args": {
              "category": "bakery",
              "mode": "compare_models",
              "sample_size": 50,
              "since": "2026-11-02T00:00:00",
              "source": "scheduled_resume",
              "time_budget_ms": 60000
            },
            "function_name": "revalidatePendingTrendLinks"
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "noise_check_bakery",
      "namespace": "base44",
      "version": "1.0"
    }
  }
}