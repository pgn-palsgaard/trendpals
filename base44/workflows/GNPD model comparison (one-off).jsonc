{
  "name": "GNPD model comparison (one-off)",
  "description": "One-off: compares Haiku 4.5 batched validation against today's Sonnet verdicts on ice cream links. Writes nothing to GNPDProduct. Created 2 Nov 2026; archive after use.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 1,
      "interval_unit": "days",
      "interval_anchor": null,
      "ends_type": "after_count",
      "ends_on_date": null,
      "ends_after_count": 1
    }
  },
  "definition": {
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "then": "end",
          "with": {
            "args": {
              "category": "ice_cream",
              "mode": "compare_models",
              "model": "claude-haiku-4-5",
              "sample_size": 60,
              "source": "scheduled_resume"
            },
            "function_name": "revalidatePendingTrendLinks"
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "gnpd_compare_models",
      "namespace": "base44",
      "version": "1.0"
    }
  }
}