{
  "name": "GNPD rejudge bakery MEA (Mintel rule)",
  "description": "Re-judges every bakery trend candidate in MENA + Sub-Saharan Africa against the Mintel-calibrated rule (9 Nov 2026). Approved/Mintel-cited links untouched. Resumable via trend_rejudged_at.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 5,
      "interval_unit": "minutes",
      "interval_anchor": null,
      "ends_type": "after_count",
      "ends_on_date": null,
      "ends_after_count": 60
    }
  },
  "definition": {
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "then": "end",
          "with": {
            "args": {
              "category": "bakery",
              "cutoff": "2026-11-09T12:40:00",
              "dry_run": true,
              "mode": "rejudge_category",
              "regions": [
                "mena",
                "sub_saharan_africa"
              ],
              "source": "scheduled_resume",
              "time_budget_ms": 40000
            },
            "function_name": "revalidatePendingTrendLinks"
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "gnpd_rejudge_bakery_mea",
      "namespace": "base44",
      "version": "1.0"
    }
  }
}