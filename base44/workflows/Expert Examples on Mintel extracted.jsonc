{
  "name": "Expert Examples on Mintel extracted",
  "description": "When a Mintel source's pipeline_stage changes to 'extracted', automatically extract expert-curated product examples from the report.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"pipeline_stage\") != null) and (.trigger.data.pipeline_stage == \"extracted\") and (.trigger.data.source_type == \"mintel\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Source"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "expert_examples_on_mintel_extracted",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "extractExpertExamples",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "extractExpertExamples"
  }
}