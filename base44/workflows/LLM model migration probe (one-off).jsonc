{
  "name": "LLM model migration probe (one-off)",
  "description": "One-off: smoke-tests Haiku 5.5 / Sonnet 5.5 against the prompt contracts of the migrated functions. Writes nothing. Archive after use.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 1,
      "interval_unit": "days",
      "interval_anchor": null,
      "ends_type": "after_count",
      "ends_on_date": null,
      "ends_after_count": 1
    }
  },
  "definition": {
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "then": "end",
          "with": {
            "args": {
              "mode": "model_probe",
              "source": "scheduled_resume"
            },
            "function_name": "revalidatePendingTrendLinks"
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "llm_model_probe",
      "namespace": "base44",
      "version": "1.0"
    }
  }
}