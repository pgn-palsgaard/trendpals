{
  "name": "Monthly detectEmergingSignals",
  "description": "Runs detectEmergingSignals on the 1st of each month at 06:00 UTC. Clusters promoted-without-trend-home excerpts (last 90d) into EmergingSignalCluster candidates. Registered INACTIVE pending Peter's approval of the first run.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 1 * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "monthly_detectemergingsignals",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "detectEmergingSignals",
            "args": {
              "triggered_by": "schedule",
              "test_flag": false
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "detectEmergingSignals"
  }
}