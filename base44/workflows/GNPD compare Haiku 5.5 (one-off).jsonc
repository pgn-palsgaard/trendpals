{
  "name": "GNPD compare Haiku 5.5 (one-off)",
  "description": "One-off: Haiku 5.5 (with prompt caching) vs stored Haiku 4.5 verdicts on bakery links. Writes nothing. Archive after use.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 1,
      "interval_unit": "days",
      "interval_anchor": null,
      "ends_type": "after_count",
      "ends_on_date": null,
      "ends_after_count": 1
    }
  },
  "definition": {
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "then": "end",
          "with": {
            "args": {
              "category": "bakery",
              "mode": "compare_models",
              "model": "claude-haiku-5-5",
              "sample_size": 100,
              "source": "scheduled_resume"
            },
            "function_name": "revalidatePendingTrendLinks"
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "gnpd_compare_haiku55",
