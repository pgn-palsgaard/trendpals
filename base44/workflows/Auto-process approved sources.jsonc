{
  "name": "Auto-process approved sources",
  "description": "When a source is human-verified (metadata_extraction.verified=true) AND approved AND still at pipeline_stage=uploaded, automatically run excerpt extraction. Idempotent: processSourceQueue skips sources that already have excerpts or are mid-extraction.",
  "trigger": {
    "condition": "${ ((.trigger.data.metadata_extraction.verified == true) and (.trigger.data.review_status == \"approved\") and (.trigger.data.pipeline_stage == \"uploaded\" or .trigger.data.pipeline_stage == \"metadata_extracted\") and (.trigger.data.pipeline_stage != \"extracting\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Source"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_process_approved_sources",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processSourceQueue",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "processSourceQueue"
  }
}